<Window x:Class="PixelCompanion.Views.PaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PixelCompanion.Converters"
        mc:Ignorable="d"
        Title="ClickClack Tasks Paper"
        Icon="pack://application:,,,/ClickClack;component/Assets/Icons/app.ico"
        Width="380" Height="520"
        MinWidth="280" MinHeight="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        RenderOptions.BitmapScalingMode="NearestNeighbor"
        RenderOptions.EdgeMode="Aliased"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Vintage Minimalist Scrollbar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#604a2e24" CornerRadius="2" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Task Row Button Style -->
        <Style x:Key="PaperTaskRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#124a2e24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete Task Button Style -->
        <Style x:Key="PaperDeleteTaskButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#43261b"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="✕" FontFamily="Consolas, Arial, sans-serif"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#b3261e"/>
                                <Setter TargetName="Bd" Property="Background" Value="#22b3261e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <!-- Standalone Paper Background Sheet -->
        <Border CornerRadius="2" Cursor="Arrow" MouseLeftButtonDown="PaperSheet_MouseLeftButtonDown">
            <Border.Background>
                <ImageBrush ImageSource="pack://application:,,,/ClickClack;component/Assets/Typewriter/paper_sheet.png" Stretch="Fill"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.45" Color="#150a05"/>
            </Border.Effect>

            <Grid>
                <Grid Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Paper Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <TextBlock Text="TODAY'S TASKS" 
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="14" FontWeight="Bold" 
                                   Foreground="#43261b"
                                   TextDecorations="Underline"/>
                    </Grid>

                    <!-- Scrollable Tasks Area -->
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="TasksScrollViewer"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Vertical">
                                <!-- Status / Empty Message -->
                                <TextBlock Text="{Binding StatusMessage}"
                                           Visibility="{Binding HasTasks, Converter={StaticResource InverseBoolToVis}}"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           FontSize="11.5" Foreground="#694a40" FontStyle="Italic"
                                           Margin="2,0,0,8"/>

                                <!-- Tasks List -->
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid x:Name="RowGrid" Margin="0,2,0,4" Background="Transparent"
                                                  FlowDirection="{Binding Text, Converter={StaticResource TextToFlowDirectionConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Clickable Row -->
                                                <Button Style="{StaticResource PaperTaskRowButtonStyle}"
                                                        Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Grid.Column="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Checkbox Box -->
                                                        <Border Width="16" Height="16" 
                                                                Background="#f5eedc" BorderBrush="#43261b" BorderThickness="1.5"
                                                                CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                Grid.Column="0">
                                                            <TextBlock Text="✓" FontSize="12" FontWeight="Bold"
                                                                       Foreground="#1d4a42" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Margin="0,-3,0,0"
                                                                       Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"/>
                                                        </Border>

                                                        <!-- Task Text with Guaranteed Ink Strikethrough -->
                                                        <TextBlock Text="{Binding Text}" 
                                                                   FontFamily="{StaticResource AppFontFamily}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                                   Grid.Column="1">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#25140e"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Foreground" Value="#8a6c62"/>
                                                                            <Setter Property="TextDecorations">
                                                                                <Setter.Value>
                                                                                    <TextDecorationCollection>
                                                                                        <TextDecoration Location="Strikethrough">
                                                                                            <TextDecoration.Pen>
                                                                                                <Pen Brush="#5e3a2f" Thickness="1.5"/>
                                                                                            </TextDecoration.Pen>
                                                                                        </TextDecoration>
                                                                                    </TextDecorationCollection>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>

                                                <!-- Delete Button on Hover -->
                                                <Button x:Name="DelBtn"
                                                        Style="{StaticResource PaperDeleteTaskButtonStyle}"
                                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Delete task"
                                                        Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center"
                                                        Opacity="0" IsHitTestVisible="False"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DelBtn" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="DelBtn" Property="IsHitTestVisible" Value="True"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- + Sign at Bottom of Last Task -->
                                <Button x:Name="ShowAddInputBtn"
                                        Visibility="{Binding IsAddingTask, Converter={StaticResource InverseBoolToVis}}"
                                        Margin="0,2,0,4"
                                        Background="Transparent" BorderThickness="0"
                                        HorizontalAlignment="Left" Cursor="Hand"
                                        ToolTip="Add a task (+)"
                                        Click="ShowAddInputBtn_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" x:Name="AddBd" Padding="4,4" CornerRadius="3">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Pixel Box with + matching checkbox size -->
                                                    <Border Width="16" Height="16" 
                                                            Background="#f5eedc" BorderBrush="#43261b" BorderThickness="1.5"
                                                            CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="#43261b"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                                    </Border>
                                                    <TextBlock Text="New task..." FontFamily="{StaticResource AppFontFamily}"
                                                               FontSize="11.5" Foreground="#7a6258" FontStyle="Italic"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="AddBd" Property="Background" Value="#124a2e24"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Inline Task Input Row (Box for Checkbox + Simple Line) -->
                                <Grid x:Name="InlineInputRow"
                                      Visibility="{Binding IsAddingTask, Converter={StaticResource BoolToVis}}"
                                      FlowDirection="{Binding NewTaskText, Converter={StaticResource TextToFlowDirectionConverter}}"
                                      Margin="4,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Empty Checkbox matching task rows -->
                                    <Border Width="16" Height="16" 
                                            Background="#f5eedc" BorderBrush="#43261b" BorderThickness="1.5"
                                            CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Grid.Column="0"/>

                                    <!-- Simple Line Text Input -->
                                    <TextBox x:Name="PaperTaskInput"
                                             Text="{Binding NewTaskText, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource AppFontFamily}"
                                             FontSize="12" Foreground="#2d1c16" CaretBrush="#43261b"
                                             Background="Transparent"
                                             BorderThickness="0,0,0,1.5" BorderBrush="#5e3a2f"
                                             Padding="2,1,2,3"
                                             VerticalAlignment="Center"
                                             Grid.Column="1"
                                             KeyDown="PaperTaskInput_KeyDown"
                                             LostFocus="PaperTaskInput_LostFocus"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

            <!-- Close Button: Positioned Directly In The Folded Corner -->
            <Button x:Name="PaperWindowCloseBtn"
                    Width="22" Height="22"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,29,29,0"
                    Background="Transparent" BorderThickness="0"
                    Cursor="Hand" ToolTip="Close paper (Esc)"
                    Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" x:Name="BtnBd">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Image Source="pack://application:,,,/ClickClack;component/Assets/Icons/close.png"
                       Width="16" Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </Grid>
    </Border>
</Grid>
</Window>
