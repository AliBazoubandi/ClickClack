<Window x:Class="PixelCompanion.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClickClack Settings"
        Icon="pack://application:,,,/ClickClack;component/Assets/Icons/app.ico"
        Width="520" Height="480"
        MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#1a1d24"
        Foreground="#e8e2d5"
        FontFamily="Segoe UI, Tahoma">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252a34"/>
            <Setter Property="Foreground" Value="#f4ede0"/>
            <Setter Property="BorderBrush" Value="#3c4452"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2e585c"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#417378"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Obsidian Vault Settings" FontSize="18" FontWeight="Bold" Foreground="#f5cf7a"/>
            <TextBlock Text="Connect your vintage typewriter to your daily tasks note" FontSize="12" Foreground="#9aa0ad" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form Fields inside ScrollViewer for responsiveness -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel VerticalAlignment="Top">
                <!-- Vault Root -->
                <TextBlock Text="Obsidian Vault Root Folder:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding VaultPath, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Margin="0,0,8,0"/>
                    <Button Content="Browse..." Command="{Binding BrowseVaultCommand}" Grid.Column="1" Padding="14,6"/>
                </Grid>

                <!-- Daily Notes Folder -->
                <TextBlock Text="Daily Notes Subfolder (optional, e.g. 'Daily Notes'):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Text="{Binding DailyNotesFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <!-- Date Format -->
                <TextBlock Text="Daily Note Date Format:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Text="{Binding DailyNoteDateFormat, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                <TextBlock Margin="0,0,0,14" FontSize="11" Foreground="#9aa0ad">
                    <Run Text="Expected filename today: "/>
                    <Run Text="{Binding PreviewFileName, Mode=OneWay}" FontWeight="Bold" Foreground="#8ec5bb"/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Background="#353b47" BorderBrush="#4a5263" Margin="0,0,10,0" Width="80"/>
            <Button Content="Save Settings" Command="{Binding SaveCommand}" Background="#2e585c" Width="110"/>
        </StackPanel>
    </Grid>
</Window>
