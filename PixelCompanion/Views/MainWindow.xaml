<!-- Scaling rule: RenderOptions.BitmapScalingMode="HighQuality" where display size < source asset size (prevents downscale aliasing); NearestNeighbor where display size >= source. -->
<Window x:Class="PixelCompanion.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PixelCompanion.ViewModels"
        xmlns:conv="clr-namespace:PixelCompanion.Converters"
        mc:Ignorable="d"
        Title="ClickClack"
        Icon="pack://application:,,,/ClickClack;component/Assets/Icons/app.ico"
        Width="480" Height="420"
        MinWidth="260" MinHeight="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="{Binding IsAlwaysOnTop, Mode=OneWay}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        RenderOptions.BitmapScalingMode="NearestNeighbor"
        RenderOptions.EdgeMode="Aliased"
        TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Vintage Minimalist Scrollbar Style for Parchment -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#554a2e24" CornerRadius="2" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Retro Pixel Checkbox Style -->
        <Style x:Key="PixelCheckboxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="14" Height="14" 
                                Background="#f5eedc" BorderBrush="#43261b" BorderThickness="1.5"
                                CornerRadius="1" Margin="0,1,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CheckMark" Text="✓" FontSize="11" FontWeight="Bold"
                                       Foreground="#22524a" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" Margin="0,-3,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="Background" Value="#dfd4b8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#823c28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Task Row Button Style -->
        <Style x:Key="TaskRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete Task Button Style -->
        <Style x:Key="DeleteTaskButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#43261b"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="✕" FontFamily="Consolas, Arial, sans-serif"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#b3261e"/>
                                <Setter TargetName="Bd" Property="Background" Value="#22b3261e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Edit Task Button Style -->
        <Style x:Key="EditTaskButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#43261b"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="✎" FontFamily="Segoe UI Symbol, Consolas, Arial, sans-serif"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#823c28"/>
                                <Setter TargetName="Bd" Property="Background" Value="#22823c28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootContainer" Background="Transparent" SnapsToDevicePixels="True">

        <!-- Proportional Scaling Viewbox: Scales scene uniformly while preserving aspect ratio -->
        <Viewbox Stretch="Uniform" SnapsToDevicePixels="True"
                 RenderOptions.BitmapScalingMode="NearestNeighbor"
                 RenderOptions.EdgeMode="Aliased">
            <Canvas Width="480" Height="420" SnapsToDevicePixels="True">

                <!-- Dynamic Paper Layer (Tall & popping out behind typewriter roller) -->
                <Border x:Name="PaperContainer"
                        Panel.ZIndex="0"
                        Visibility="{Binding IsPaperExtended, Converter={StaticResource BoolToVis}}"
                        Width="225" Height="285"
                        Canvas.Left="45" Canvas.Top="10"
                        CornerRadius="2"
                        ClipToBounds="True"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        CacheMode="BitmapCache">
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/ClickClack;component/Assets/Typewriter/paper_sheet.png" Stretch="Fill"/>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.35" Color="#22110c"/>
                    </Border.Effect>

                    <!-- Visible Portion of Paper (Height="175" prominently sticking up above the roller) -->
                    <Grid Height="175" VerticalAlignment="Top">
                        <!-- Content Area with Margins -->
                        <Grid Margin="12,12,24,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header: Day Navigation + Pen Button -->
                            <!-- Header: Day Navigation + Pen Button (Centered, safe from top-right close button) -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,18,6">
                                <!-- Prev Day Button -->
                                <Button Command="{Binding PrevDayCommand}"
                                        IsEnabled="{Binding CanGoPrev}"
                                        Content="◀"
                                        FontFamily="Consolas, Arial, sans-serif"
                                        FontSize="10"
                                        Foreground="#43261b"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Padding="3,0"
                                        ToolTip="Previous day"
                                        VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" x:Name="Bd" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#15000000"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.25"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Day Label / Today Button -->
                                <Button Command="{Binding TodayCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="Click to return to Today"
                                        VerticalAlignment="Center"
                                        Margin="4,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" x:Name="Bd">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding DayLabel}" 
                                               FontFamily="{StaticResource AppFontFamily}"
                                               FontSize="11" FontWeight="Bold" 
                                               Foreground="#43261b"
                                               TextDecorations="Underline"/>
                                </Button>

                                <!-- Next Day Button -->
                                <Button Command="{Binding NextDayCommand}"
                                        IsEnabled="{Binding CanGoNext}"
                                        Content="▶"
                                        FontFamily="Consolas, Arial, sans-serif"
                                        FontSize="10"
                                        Foreground="#43261b"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Padding="3,0"
                                        ToolTip="Next day"
                                        VerticalAlignment="Center"
                                        Margin="0,0,4,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" x:Name="Bd" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#15000000"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.25"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Pen Icon Button: Opens Full Paper Window -->
                                <Button x:Name="OpenPaperBtn"
                                        Width="16" Height="16"
                                        Margin="2,0,0,0"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="Open full tasks paper (click to edit &amp; add tasks)"
                                        Click="OpenPaperBtn_Click"
                                        VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" x:Name="BtnBd">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBd" Property="Opacity" Value="0.7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Image Source="pack://application:,,,/ClickClack;component/Assets/Icons/pen.png"
                                           Width="13" Height="13"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                            </StackPanel>

                            <!-- Tasks List Area -->
                            <Grid Grid.Row="1" Margin="0,0,0,2">
                            <!-- Empty / Status State -->
                            <TextBlock Text="{Binding StatusMessage}"
                                       Visibility="{Binding HasTasks, Converter={StaticResource InverseBoolToVis}}"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="10" Foreground="#694a40"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       VerticalAlignment="Center" Margin="4"/>

                            <!-- Active Tasks Scroll Area -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid x:Name="TaskRowGrid" Margin="0,1,0,3" Background="Transparent"
                                                  FlowDirection="{Binding Text, Converter={StaticResource TextToFlowDirectionConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Full Clickable Task Row (Shown when not editing) -->
                                                <Button Style="{StaticResource TaskRowButtonStyle}"
                                                        Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"
                                                        MouseDoubleClick="TaskRow_MouseDoubleClick"
                                                        Grid.Column="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Checkbox Indicator -->
                                                        <Border Width="13" Height="13" 
                                                                Background="#f5eedc" BorderBrush="#43261b" BorderThickness="1.5"
                                                                CornerRadius="1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                Grid.Column="0">
                                                            <TextBlock Text="✓" FontSize="10.5" FontWeight="Bold"
                                                                       Foreground="#22524a" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Margin="0,-3,0,0"
                                                                       Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"/>
                                                        </Border>

                                                        <!-- Task Text with Guaranteed Ink Strikethrough -->
                                                        <TextBlock Text="{Binding Text}" 
                                                                   FontFamily="{StaticResource AppFontFamily}"
                                                                   FontSize="10.5"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                                   Grid.Column="1">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#2d1c16"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Foreground" Value="#88726b"/>
                                                                            <Setter Property="TextDecorations">
                                                                                <Setter.Value>
                                                                                    <TextDecorationCollection>
                                                                                        <TextDecoration Location="Strikethrough">
                                                                                            <TextDecoration.Pen>
                                                                                                <Pen Brush="#5e3a2f" Thickness="1.5"/>
                                                                                            </TextDecoration.Pen>
                                                                                        </TextDecoration>
                                                                                    </TextDecorationCollection>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>

                                                <!-- Inline Edit Row (Shown when IsEditing is true) -->
                                                <Grid Grid.Column="0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" Margin="1,0,1,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="13" Height="13" 
                                                            Background="#f5eedc" BorderBrush="#43261b" BorderThickness="1.5"
                                                            CornerRadius="1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                            Grid.Column="0">
                                                        <TextBlock Text="✓" FontSize="10.5" FontWeight="Bold"
                                                                   Foreground="#22524a" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Margin="0,-3,0,0"
                                                                   Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"/>
                                                    </Border>
                                                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                             FontFamily="{StaticResource AppFontFamily}"
                                                             FontSize="10.5" Foreground="#2d1c16" CaretBrush="#43261b"
                                                             Background="Transparent"
                                                             BorderThickness="0,0,0,1.5" BorderBrush="#823c28"
                                                             Padding="1,0,1,1" VerticalAlignment="Center"
                                                             Grid.Column="1"
                                                             FlowDirection="{Binding EditText, Converter={StaticResource TextToFlowDirectionConverter}}"
                                                             Loaded="EditTaskInput_Loaded"
                                                             KeyDown="EditTaskInput_KeyDown"
                                                             LostFocus="EditTaskInput_LostFocus"/>
                                                </Grid>

                                                <!-- Action Buttons (✎ Edit & ✕ Delete) on Hover -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                                                    <!-- Edit Task Button (✎) -->
                                                    <Button x:Name="EditTaskBtn"
                                                            Style="{StaticResource EditTaskButtonStyle}"
                                                            Command="{Binding DataContext.StartEditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Edit task (or double-click text)"
                                                            Opacity="0" IsHitTestVisible="False"/>

                                                    <!-- Delete Task Button (×) -->
                                                    <Button x:Name="DeleteTaskBtn"
                                                            Style="{StaticResource DeleteTaskButtonStyle}"
                                                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Delete task"
                                                            Opacity="0" IsHitTestVisible="False"/>
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="EditTaskBtn" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="EditTaskBtn" Property="IsHitTestVisible" Value="True"/>
                                                    <Setter TargetName="DeleteTaskBtn" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="DeleteTaskBtn" Property="IsHitTestVisible" Value="True"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- Close Button: Positioned Directly In The Folded Corner -->
                    <Button x:Name="PaperCloseBtn"
                            Width="16" Height="16"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,17,17,0"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Retract paper"
                            Click="PaperCloseBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" x:Name="BtnBd">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBd" Property="Opacity" Value="0.65"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Image Source="pack://application:,,,/ClickClack;component/Assets/Icons/close.png"
                               Width="12" Height="12"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </Grid>
            </Border>

                <!-- Typewriter (In Front of the paper) -->
                <Image x:Name="TypewriterSprite"
                       Panel.ZIndex="1"
                       Source="{Binding TypewriterImage}"
                       Width="285"
                       Canvas.Left="15" Canvas.Bottom="10"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       CacheMode="BitmapCache"
                       Cursor="Hand"
                       ToolTip="Click typewriter to extend/retract paper!"
                       MouseLeftButtonDown="Typewriter_MouseLeftButtonDown">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.35" Color="#0a0c10"/>
                    </Image.Effect>
                </Image>

                <!-- Pet Companion ("Inky") - Previous frame during state crossfade -->
                <Image x:Name="PrevCompanionSprite"
                       Panel.ZIndex="2"
                       Source="{Binding PrevCompanionImage}"
                       Width="130"
                       Canvas.Right="40" Canvas.Bottom="10"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       CacheMode="BitmapCache"
                       Opacity="0"
                       IsHitTestVisible="False">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="PrevCompanionBobTransform" X="0" Y="0"/>
                    </Image.RenderTransform>
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.3" Color="#0a0c10"/>
                    </Image.Effect>
                </Image>

                <!-- Pet Companion ("Inky") -->
                <Image x:Name="CompanionSprite"
                       Panel.ZIndex="3"
                       Source="{Binding CompanionImage}"
                       Width="130"
                       Canvas.Right="40" Canvas.Bottom="10"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       CacheMode="BitmapCache"
                       Cursor="Hand"
                       ToolTip="Inky (Click to pet!)"
                       MouseLeftButtonDown="Companion_MouseLeftButtonDown">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="CompanionBobTransform" X="0" Y="0"/>
                    </Image.RenderTransform>
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.3" Color="#0a0c10"/>
                    </Image.Effect>
                </Image>

            </Canvas>
        </Viewbox>

        <!-- Multi-Directional Resize Grips (Hit-targets with #01000000 for guaranteed hit-testing) -->
        <!-- Edges -->
        <Border Height="10" VerticalAlignment="Top" Background="#01000000" Cursor="SizeNS"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                MouseMove="ResizeGrip_MouseMove"
                MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp" Tag="Top"/>
        <Border Height="10" VerticalAlignment="Bottom" Background="#01000000" Cursor="SizeNS"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                MouseMove="ResizeGrip_MouseMove"
                MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp" Tag="Bottom"/>
        <Border Width="10" HorizontalAlignment="Left" Background="#01000000" Cursor="SizeWE"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                MouseMove="ResizeGrip_MouseMove"
                MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp" Tag="Left"/>
        <Border Width="10" HorizontalAlignment="Right" Background="#01000000" Cursor="SizeWE"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                MouseMove="ResizeGrip_MouseMove"
                MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp" Tag="Right"/>

        <!-- Corners -->
        <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#01000000" Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                MouseMove="ResizeGrip_MouseMove"
                MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp" Tag="TopLeft"/>
        <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="#01000000" Cursor="SizeNESW"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                MouseMove="ResizeGrip_MouseMove"
                MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp" Tag="TopRight"/>
        <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="#01000000" Cursor="SizeNESW"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                MouseMove="ResizeGrip_MouseMove"
                MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp" Tag="BottomLeft"/>
        <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="#01000000" Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                MouseMove="ResizeGrip_MouseMove"
                MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp" Tag="BottomRight"/>

    </Grid>
</Window>
